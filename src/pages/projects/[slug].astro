---
import SectionHeading from "../../components/SectionHeading.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ToolAvatar from "../../components/ToolAvatar.astro";
import { rankings, type RankingItem } from "../../data/rankings";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return rankings.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: RankingItem;
}

const { item } = Astro.props;
const related = rankings
  .filter((candidate) => candidate.category === item.category && candidate.slug !== item.slug)
  .slice(0, 3);
const alternatives = item.alternatives
  .map((name) => rankings.find((candidate) => candidate.name === name))
  .filter((candidate): candidate is RankingItem => Boolean(candidate));
const detailStats = [
  { label: "榜单排名", value: `#${item.rank.toString().padStart(2, "0")}` },
  { label: "本周增长", value: item.weeklyGrowth },
  { label: "收藏数", value: item.totalStars },
  { label: "综合评分", value: item.score }
];
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path.startsWith("/") ? path : `/${path}`}`;
---

<Layout title={`${item.name} | AI 工具导航`} description={item.description}>
  <SiteHeader active="ranking" repoUrl={item.repoUrl} />

  <main class="pb-16 pt-5 sm:pb-24 sm:pt-6">
    <section class="shell">
      <a
        class="mono inline-flex items-center gap-2 rounded-lg border border-[var(--border-soft)] bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--text-muted)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:text-[var(--accent)]"
        href={withBase("/")}
      >
        <span aria-hidden="true">←</span>
        返回榜单
      </a>

      <div class="surface-card hero-grid mt-5 overflow-hidden px-6 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-end">
          <div>
            <p class="eyebrow">{item.category}</p>
            <div class="mt-6 flex flex-col gap-5 sm:flex-row sm:items-center">
              <ToolAvatar name={item.name} avatarUrl={item.avatarUrl} class="h-16 w-16 sm:h-20 sm:w-20" />
              <h1 class="max-w-4xl text-5xl font-extrabold tracking-[-0.04em] text-[var(--text-primary)] sm:text-6xl lg:text-7xl">
                {item.name}
              </h1>
            </div>
            <p class="mt-6 max-w-2xl text-base leading-8 text-[var(--text-muted)] sm:text-lg">
              {item.description}
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <span class="accent-chip">#{tag}</span>
              ))}
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                class="rounded-lg bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-[var(--text-inverse)] shadow-sm shadow-blue-500/20 transition duration-200 hover:-translate-y-0.5 hover:bg-blue-600"
                href={item.websiteUrl}
                target="_blank"
                rel="noreferrer"
              >
                打开官网
              </a>
              <a
                class="rounded-lg border border-[var(--border-strong)] bg-white px-5 py-3 text-sm font-semibold text-[var(--text-primary)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)]"
                href={item.repoUrl}
                target="_blank"
                rel="noreferrer"
              >
                查看仓库
              </a>
            </div>
          </div>

          <aside class="surface-card-strong p-6">
            <p class="text-xs font-semibold text-[var(--text-muted)]">仓库地址</p>
            <p class="mt-3 text-2xl font-extrabold tracking-tight">{item.repo}</p>
            <p class="mt-5 border-t border-[var(--border-soft)] pt-5 text-sm leading-7 text-[var(--text-muted)]">
              {item.insight}
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="shell mt-10 sm:mt-14">
      <div class="grid gap-5 md:grid-cols-4">
        {detailStats.map((stat) => (
          <div class="surface-card-strong p-5">
            <p class="mono text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">{stat.label}</p>
            <p class="mt-3 text-3xl font-extrabold tracking-tight">{stat.value}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="shell mt-12 sm:mt-16">
      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_360px]">
        <article class="surface-card p-6 sm:p-8">
          <SectionHeading
            eyebrow="工具说明"
            title="为什么值得看"
            description="这里用尽量直白的话说明它的用途、亮点和使用前需要注意的地方。"
          />

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
              <p class="text-xs font-semibold text-[var(--text-muted)]">增长信号</p>
              <p class="mt-4 text-sm leading-7 text-[var(--text-muted)]">
                {item.weeklyGrowth} 的周增长让它在同类项目里更容易被注意，适合进入首页重点曝光位。
              </p>
            </div>
            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
              <p class="text-xs font-semibold text-[var(--text-muted)]">适合场景</p>
              <p class="mt-4 text-sm leading-7 text-[var(--text-muted)]">
                {item.description}
              </p>
            </div>
            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
              <p class="text-xs font-semibold text-[var(--text-muted)]">推荐理由</p>
              <p class="mt-4 text-sm leading-7 text-[var(--text-muted)]">
                {item.insight}
              </p>
            </div>
          </div>

          <div class="mt-8 rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5 sm:p-6">
            <p class="text-xs font-semibold text-[var(--text-muted)]">主要亮点</p>
            <div class="mt-5 grid gap-3">
              {item.highlights.map((highlight, index) => (
                <div class="flex gap-4 rounded-xl border border-[var(--border-soft)] bg-white p-4">
                  <span class="mono text-xs font-semibold text-[var(--accent)]">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                  <p class="text-sm leading-7 text-[var(--text-muted)]">{highlight}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-5 grid gap-5 lg:grid-cols-2">
            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5 sm:p-6">
              <p class="text-xs font-semibold text-[var(--text-muted)]">适合谁用</p>
              <div class="mt-5 space-y-3">
                {item.useCases.map((useCase) => (
                  <p class="rounded-xl border border-[var(--border-soft)] bg-white p-4 text-sm leading-7 text-[var(--text-muted)]">
                    {useCase}
                  </p>
                ))}
              </div>
            </div>

            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5 sm:p-6">
              <p class="text-xs font-semibold text-[var(--text-muted)]">使用前注意</p>
              <div class="mt-5 space-y-3">
                {item.limitations.map((limitation) => (
                  <p class="rounded-xl border border-[var(--border-soft)] bg-white p-4 text-sm leading-7 text-[var(--text-muted)]">
                    {limitation}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </article>

        <aside class="space-y-5">
          <div class="surface-card-strong p-6 sm:p-7">
            <p class="eyebrow">同类对比</p>
            <h2 class="mt-4 text-2xl font-extrabold tracking-tight">可一起对比的项目</h2>
            <div class="mt-6 space-y-3">
              {alternatives.map((candidate) => (
                <a
                  class="block rounded-xl border border-[var(--border-soft)] bg-white p-4 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-md hover:shadow-blue-950/10"
                  href={withBase(`/projects/${candidate.slug}/`)}
                >
                  <p class="mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-muted)]">
                    #{candidate.rank.toString().padStart(2, "0")} · {candidate.category}
                  </p>
                  <h3 class="mt-2 text-base font-extrabold">{candidate.name}</h3>
                  <p class="mt-2 text-sm leading-7 text-[var(--text-muted)]">{candidate.description}</p>
                </a>
              ))}
            </div>
          </div>

          <div class="surface-card-strong p-6 sm:p-7">
            <p class="eyebrow">继续浏览</p>
            <h2 class="mt-4 text-2xl font-extrabold tracking-tight">继续看 {item.category}</h2>
            <div class="mt-6 space-y-3">
              {related.length > 0 ? (
                related.map((candidate) => (
                  <a
                    class="block rounded-xl border border-[var(--border-soft)] bg-white p-4 transition duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-md hover:shadow-blue-950/10"
                    href={withBase(`/projects/${candidate.slug}/`)}
                  >
                    <p class="mono text-[11px] uppercase tracking-[0.18em] text-[var(--text-muted)]">
                      #{candidate.rank.toString().padStart(2, "0")} · {candidate.weeklyGrowth}
                    </p>
                    <h3 class="mt-2 text-base font-extrabold">{candidate.name}</h3>
                    <p class="mt-2 text-sm leading-7 text-[var(--text-muted)]">{candidate.description}</p>
                  </a>
                ))
              ) : (
                <p class="rounded-xl border border-[var(--border-soft)] bg-white p-4 text-sm leading-7 text-[var(--text-muted)]">
                  当前没有同分类的其它项目，可以返回首页继续浏览完整榜单。
                </p>
              )}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>
