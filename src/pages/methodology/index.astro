---
import SiteHeader from "../../components/SiteHeader.astro";
import { categories, methodology, rankings } from "../../data/rankings";
import Layout from "../../layouts/Layout.astro";

const featuredCount = rankings.filter((item) => item.featured).length;
---

<Layout
  title="排行方法 | AI 工具导航"
  description="用简单的话说明 AI 工具榜单为什么这样排序。"
>
  <SiteHeader active="methodology" repoUrl={rankings[0]?.repoUrl} />

  <main class="pb-16 pt-12 sm:pb-24 sm:pt-16">
    <section class="shell">
      <div class="surface-card p-6 sm:p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="eyebrow">排行方法</p>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-4xl">
              排行方法
            </h1>
          </div>
          <p class="max-w-xl text-sm leading-7 text-[var(--text-muted)] md:text-right">
            榜单不是只看谁最火，也会看它是否稳定、是否容易上手、是否值得新手花时间了解。
          </p>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {methodology.map((item) => (
            <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
              <p class="mono text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">{item.label}</p>
              <p class="mt-4 text-3xl font-extrabold tracking-tight">{item.value}</p>
              <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">{item.detail}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
            <p class="text-xs font-semibold text-[var(--text-muted)]">已收录工具</p>
            <p class="mt-4 text-3xl font-extrabold tracking-tight">{rankings.length}</p>
            <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">当前进入榜单和目录的数据条目。</p>
          </div>
          <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
            <p class="text-xs font-semibold text-[var(--text-muted)]">榜单分类</p>
            <p class="mt-4 text-3xl font-extrabold tracking-tight">{categories.length - 1}</p>
            <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">用于首页榜单的大类筛选。</p>
          </div>
          <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] p-5">
            <p class="text-xs font-semibold text-[var(--text-muted)]">优先推荐</p>
            <p class="mt-4 text-3xl font-extrabold tracking-tight">{featuredCount}</p>
            <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">编辑优先推荐、适合打开详情页继续看的项目。</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
