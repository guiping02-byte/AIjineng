---
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path.startsWith("/") ? path : `/${path}`}`;
---

<footer class="border-t border-white/10 bg-[#0d120f] text-white">
  <div class="shell flex flex-col gap-8 py-8 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-base font-extrabold">AI 工具库</p>
      <p class="mt-2 text-sm text-white/55">给新手看的 AI 工具导航。</p>
    </div>
    <nav class="flex flex-wrap gap-x-7 gap-y-3 text-sm font-bold text-white/76" aria-label="底部导航">
      <a class="transition duration-200 hover:text-white" href={withBase("/skills/")}>工具库</a>
      <a class="transition duration-200 hover:text-white" href={withBase("/#ranking")}>本周榜单</a>
      <a class="transition duration-200 hover:text-white" href={withBase("/methodology/")}>排行方法</a>
    </nav>
  </div>
</footer>
