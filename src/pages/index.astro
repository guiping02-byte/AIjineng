---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ToolAvatar from "../components/ToolAvatar.astro";
import { methodology, rankings } from "../data/rankings";
import Layout from "../layouts/Layout.astro";

const getPrimaryDate = (dates: string[]) => {
  const dateCounts = dates
    .filter(Boolean)
    .reduce<Record<string, number>>((counts, date) => {
      counts[date] = (counts[date] || 0) + 1;
      return counts;
    }, {});

  return Object.entries(dateCounts)
    .sort(([dateA, countA], [dateB, countB]) => countB - countA || dateB.localeCompare(dateA))
    .at(0)?.[0] || new Date().toISOString().slice(0, 10);
};

const addDays = (dateString: string, days: number) => {
  const date = new Date(`${dateString}T00:00:00`);
  date.setDate(date.getDate() + days);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
};

const formatShortDate = (dateString: string) => dateString.slice(5);

const getIsoWeek = (dateString: string) => {
  const date = new Date(`${dateString}T00:00:00`);
  const day = date.getDay() || 7;
  date.setDate(date.getDate() + 4 - day);
  const yearStart = new Date(date.getFullYear(), 0, 1);
  return Math.ceil(((date.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
};

const rankingCollectedAt = getPrimaryDate(rankings.map((item) => item.collectedAt));
const rankingReviewedAt = getPrimaryDate(rankings.map((item) => item.reviewedAt));
const rankingPeriodStart = addDays(rankingCollectedAt, -6);
const rankingSnapshot = {
  week: `${rankingCollectedAt.slice(0, 4)} 第 ${getIsoWeek(rankingCollectedAt)} 周`,
  period: `${formatShortDate(rankingPeriodStart)} - ${formatShortDate(rankingCollectedAt)}`,
  collectedAt: `${formatShortDate(rankingCollectedAt)} 12:01`,
  reviewedAt: `${formatShortDate(rankingReviewedAt)} 12:01`
};

const methodSteps = [
  {
    number: "01",
    title: "发现候选",
    description: "从榜单、官方目录和你的收藏里发现值得关注的新工具。"
  },
  {
    number: "02",
    title: "拉取快照",
    description: "记录收藏数、更新时间、项目链接和仓库状态。"
  },
  {
    number: "03",
    title: "人工核验",
    description: "检查安装路径、风险提示和新手是否真的能看懂。"
  },
  {
    number: "04",
    title: "发布周榜",
    description: "保留来源、更新日期和编辑判断，方便后续复盘。"
  }
];
---

<Layout
  title="AI 工具导航"
  description="给 AI 新手看的工具和开源项目榜单，按用途筛选，快速找到适合自己的工具。"
>
  <SiteHeader active="ranking" repoUrl={rankings[0]?.repoUrl} />

  <main class="pb-16 pt-5 sm:pb-24 sm:pt-6">
    <section class="shell">
      <div class="surface-card hero-simple overflow-hidden px-6 py-10 sm:px-8 sm:py-12 lg:px-12">
        <div class="relative z-10 max-w-3xl">
          <p class="eyebrow">AI 工具导航</p>
          <h1 class="mt-6 text-4xl font-extrabold tracking-[-0.035em] text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
            给新手看的 AI 工具和开源项目榜单
          </h1>
          <p class="mt-5 text-base leading-8 text-[var(--text-muted)] sm:text-lg">
            不用先懂一堆技术名词。这里把值得关注的 AI 工具、AI 应用和开发工具放在一起，你可以按用途筛选，先看推荐，再进入详情页了解适不适合自己。
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="rounded-lg bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-[var(--text-inverse)] shadow-sm shadow-blue-500/20 transition duration-200 hover:-translate-y-0.5 hover:bg-blue-600"
              href="/skills/"
            >
              找可用工具
            </a>
            <a
              class="rounded-lg border border-[var(--border-strong)] bg-white px-5 py-3 text-sm font-semibold text-[var(--text-primary)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent)]"
              href="/skills/"
            >
              按分类筛选
            </a>
            <a
              class="rounded-lg border border-transparent px-5 py-3 text-sm font-semibold text-[var(--text-muted)] transition duration-200 hover:text-[var(--accent)]"
              href="/methodology/"
            >
              榜单怎么算
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="ranking" class="shell mt-10 sm:mt-14">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">本周榜单</p>
          <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-4xl">
            最近更值得关注的工具
          </h2>
        </div>
        <p class="max-w-xl text-sm leading-7 text-[var(--text-muted)] md:text-right">
          先按大类选，再用搜索缩小范围。点任意工具卡片可以进入详情页。
        </p>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-xl border border-blue-100 bg-blue-50/45 px-4 py-3 text-xs font-semibold text-[var(--text-muted)]">
        <span class="font-extrabold text-blue-700">{rankingSnapshot.week}</span>
        <span class="hidden h-3 w-px bg-blue-900/10 sm:inline-block"></span>
        <span>统计区间 {rankingSnapshot.period}</span>
        <span class="hidden h-3 w-px bg-blue-900/10 sm:inline-block"></span>
        <span>抓取于 {rankingSnapshot.collectedAt}</span>
        <span class="hidden h-3 w-px bg-blue-900/10 sm:inline-block"></span>
        <span>人工审核于 {rankingSnapshot.reviewedAt}</span>
      </div>

      <div class="mt-8 grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div class="flex flex-wrap items-center gap-3">
          <label class="flex min-w-full items-center gap-3 rounded-lg border border-[var(--border-soft)] bg-white px-4 py-2.5 sm:min-w-[320px]">
            <span class="text-xs font-semibold text-[var(--text-muted)]">搜索</span>
            <input
              type="search"
              class="min-w-0 flex-1 bg-transparent text-sm font-semibold text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)]"
              placeholder="输入工具名、用途或标签"
              data-search-input
            />
          </label>

          <label class="flex items-center gap-3 rounded-lg border border-[var(--border-soft)] bg-white px-4 py-2.5">
            <input
              type="checkbox"
              class="h-4 w-4 accent-[var(--accent)]"
              data-featured-toggle
            />
            <span class="text-xs font-semibold text-[var(--text-primary)]">只看推荐</span>
          </label>

          <label class="flex items-center gap-3 rounded-lg border border-[var(--border-soft)] bg-white px-4 py-2.5">
            <span class="text-xs font-semibold text-[var(--text-muted)]">排序</span>
            <select
              class="bg-transparent text-xs font-semibold text-[var(--text-primary)] outline-none"
              data-sort-select
            >
              <option value="rank">默认排序</option>
              <option value="growth">按本周增长</option>
              <option value="score">按综合评分</option>
              <option value="stars">按收藏数</option>
              <option value="name">按名称</option>
            </select>
          </label>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold text-[var(--text-muted)]">
          <p>
            推荐：
            <span class="ml-1 text-[var(--text-primary)]" data-active-featured>不限</span>
          </p>
          <p>
            排序：
            <span class="ml-1 text-[var(--text-primary)]" data-active-sort>默认排序</span>
          </p>
          <p>
            搜索：
            <span class="ml-1 text-[var(--text-primary)]" data-active-query>不限</span>
          </p>
          <p>
            共
            <span class="mx-1 text-[var(--text-primary)]" data-visible-count>{rankings.length}</span>
            个工具
          </p>
        </div>
      </div>

      <div class="mt-8">
        <div class="surface-card overflow-hidden">
          <div class="grid grid-cols-[72px_minmax(0,1fr)_110px_92px] border-b border-[var(--border-soft)] bg-[#f5f8ff] px-5 py-4 text-[11px] font-semibold text-[var(--text-muted)]">
            <span>排名</span>
            <span>工具</span>
            <span>增长</span>
            <span>评分</span>
          </div>

          <div class="divide-y divide-[var(--border-soft)]" data-ranking-list>
            {rankings.map((item) => (
              <a
                class="grid grid-cols-[72px_minmax(0,1fr)_110px_92px] gap-3 px-5 py-5 transition duration-200 hover:bg-[#f7fbff]"
                href={`/projects/${item.slug}/`}
                data-ranking-row
                data-category={item.category}
                data-featured={item.featured ? "true" : "false"}
                data-rank={item.rank}
                data-growth={item.weeklyGrowth.replace("+", "").replace("k", "")}
                data-score={item.score.split(" / ")[0]}
                data-stars={item.totalStars.replace("k", "")}
                data-name={item.name.toLowerCase()}
                data-search={[item.name, item.repo, item.category, item.description, item.insight, ...item.tags].join(" ").toLowerCase()}
              >
                <div>
                  <span class="text-sm font-semibold text-[var(--text-muted)]">
                    #{item.rank.toString().padStart(2, "0")}
                  </span>
                </div>
                <div class="flex min-w-0 gap-3">
                  <ToolAvatar name={item.name} avatarUrl={item.avatarUrl} class="h-11 w-11" />
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-base font-extrabold">{item.name}</h3>
                      {item.featured && (
                        <span class="rounded-md bg-[var(--accent-soft)] px-2.5 py-1 text-[10px] font-bold text-[var(--accent)]">
                          推荐
                        </span>
                      )}
                    </div>
                    <p class="mt-2 text-xs text-[var(--text-muted)]">{item.repo}</p>
                    <p class="mt-3 max-w-xl text-sm leading-7 text-[var(--text-muted)]">{item.description}</p>
                  </div>
                </div>
                <div class="text-sm font-bold text-[var(--accent)]">{item.weeklyGrowth}</div>
                <div class="text-sm font-bold">{item.score}</div>
              </a>
            ))}

            <div class="hidden px-5 py-8 text-center" data-row-empty-state>
              <h3 class="text-2xl font-extrabold tracking-tight">没有找到匹配工具</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">
                可以换一个关键词，或者切回“全部”。
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5">
        <div class="rounded-2xl border border-[var(--border-soft)] bg-white px-5 py-5 shadow-sm shadow-blue-950/5 sm:px-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="max-w-3xl">
              <p class="text-sm font-bold text-[var(--text-primary)]">排行方法</p>
              <p class="mt-2 text-sm leading-7 text-[var(--text-muted)]">
                这个榜单主要看最近热度、产品成熟度和编辑筛选，只是帮你先缩小范围，适合先找方向，不代表绝对结论。
              </p>
            </div>
            <a
              class="text-sm font-semibold text-[var(--accent)] transition duration-200 hover:text-blue-700"
              href="/methodology/"
            >
              查看完整说明
            </a>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {methodology.map((item) => (
              <div class="rounded-xl border border-[var(--border-soft)] bg-[#f8fbff] px-4 py-4">
                <div class="flex items-baseline justify-between gap-3">
                  <p class="text-xs font-semibold tracking-[0.18em] text-[var(--text-muted)]">{item.label}</p>
                  <p class="text-base font-extrabold text-[var(--text-primary)]">{item.value}</p>
                </div>
                <p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">{item.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12 bg-[#071b3a] text-white sm:mt-16">
      <div class="shell grid gap-10 py-16 lg:grid-cols-[minmax(260px,0.8fr)_minmax(0,1.7fr)] lg:py-20">
        <div class="max-w-md">
          <p class="text-xs font-extrabold uppercase text-sky-300">Methodology</p>
          <h2 class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">
            一张能解释清楚的榜单
          </h2>
          <p class="mt-4 text-sm leading-7 text-white/68">
            增长只是发现信号，能否安装、是否持续维护、是否适合新手，才决定它能不能进入推荐区。
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {methodSteps.map((step) => (
            <div class="border-t border-white/16 pt-5 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0">
              <p class="text-sm font-extrabold text-sky-300">{step.number}</p>
              <h3 class="mt-9 text-base font-extrabold">{step.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/62">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <SiteFooter />
    </section>
  </main>
</Layout>

<script>
  const rankingRows = Array.from(document.querySelectorAll("[data-ranking-row]"));
  const rankingList = document.querySelector("[data-ranking-list]");
  const searchInput = document.querySelector("[data-search-input]");
  const featuredToggle = document.querySelector("[data-featured-toggle]");
  const sortSelect = document.querySelector("[data-sort-select]");
  const activeFeaturedLabel = document.querySelector("[data-active-featured]");
  const activeSortLabel = document.querySelector("[data-active-sort]");
  const activeQueryLabel = document.querySelector("[data-active-query]");
  const visibleCountLabel = document.querySelector("[data-visible-count]");
  const rowEmptyState = document.querySelector("[data-row-empty-state]");

  const sortLabels = {
    rank: "默认排序",
    growth: "按本周增长",
    score: "按综合评分",
    stars: "按收藏数",
    name: "按名称"
  };

  const getStateFromUrl = () => {
    const params = new URLSearchParams(window.location.search);

    return {
      featured: params.get("featured") === "true",
      sort: params.get("sort") || "rank",
      query: params.get("query") || ""
    };
  };

  const syncUrl = (state) => {
    const url = new URL(window.location.href);

    url.searchParams.delete("category");

    if (state.featured) {
      url.searchParams.set("featured", "true");
    } else {
      url.searchParams.delete("featured");
    }

    if (state.sort === "rank") {
      url.searchParams.delete("sort");
    } else {
      url.searchParams.set("sort", state.sort);
    }

    if (state.query) {
      url.searchParams.set("query", state.query);
    } else {
      url.searchParams.delete("query");
    }

    history.replaceState({}, "", `${url.pathname}${url.search}`);
  };

  const parseValue = (element, key) => {
    if (key === "name") {
      return element.dataset.name || "";
    }

    return Number(element.dataset[key] || 0);
  };

  const sortElements = (elements, sortKey) => {
    const sorted = [...elements].sort((a, b) => {
      if (sortKey === "name") {
        return parseValue(a, sortKey).localeCompare(parseValue(b, sortKey));
      }

      return parseValue(b, sortKey) - parseValue(a, sortKey);
    });

    return sortKey === "rank"
      ? sorted.sort((a, b) => parseValue(a, "rank") - parseValue(b, "rank"))
      : sorted;
  };

  const matchesState = (element, state) => {
    const matchesFeatured =
      !state.featured || element.dataset.featured === "true";
    const matchesQuery =
      !state.query || (element.dataset.search || "").includes(state.query.toLowerCase());

    return matchesFeatured && matchesQuery;
  };

  const applyFilter = (nextState, updateUrl = false) => {
    const stateFromUrl = typeof nextState === "string"
      ? { featured: false, sort: "rank", query: "" }
      : nextState;

    const validSort = Object.hasOwn(sortLabels, stateFromUrl.sort)
      ? stateFromUrl.sort
      : "rank";
    const state = {
      featured: Boolean(stateFromUrl.featured),
      sort: validSort,
      query: (stateFromUrl.query || "").trim()
    };

    if (featuredToggle instanceof HTMLInputElement) {
      featuredToggle.checked = state.featured;
    }

    if (sortSelect instanceof HTMLSelectElement) {
      sortSelect.value = state.sort;
    }

    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = state.query;
    }

    const sortedRows = sortElements(rankingRows, state.sort);
    if (rankingList) {
      sortedRows.forEach((row) => rankingList.appendChild(row));
    }

    const visibleRows = sortedRows.filter((row) => matchesState(row, state));

    sortedRows.forEach((row) => {
      row.classList.toggle("hidden", !matchesState(row, state));
    });

    if (activeFeaturedLabel) {
      activeFeaturedLabel.textContent = state.featured ? "只看推荐" : "不限";
    }

    if (activeSortLabel) {
      activeSortLabel.textContent = sortLabels[state.sort];
    }

    if (activeQueryLabel) {
      activeQueryLabel.textContent = state.query || "不限";
    }

    if (visibleCountLabel) {
      visibleCountLabel.textContent = String(visibleRows.length);
    }

    if (rowEmptyState) {
      rowEmptyState.classList.toggle("hidden", visibleRows.length > 0);
    }

    if (updateUrl) {
      syncUrl(state);
    }
  };

  if (featuredToggle instanceof HTMLInputElement) {
    featuredToggle.addEventListener("change", () => {
      applyFilter(
        {
          ...getStateFromUrl(),
          featured: featuredToggle.checked
        },
        true
      );
    });
  }

  if (sortSelect instanceof HTMLSelectElement) {
    sortSelect.addEventListener("change", () => {
      applyFilter(
        {
          ...getStateFromUrl(),
          sort: sortSelect.value
        },
        true
      );
    });
  }

  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", () => {
      applyFilter(
        {
          ...getStateFromUrl(),
          query: searchInput.value
        },
        true
      );
    });
  }

  window.addEventListener("popstate", () => {
    applyFilter(getStateFromUrl(), false);
  });

  applyFilter(getStateFromUrl(), false);
</script>
